                TIME_SLOT_REF1="ts70" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>передвигает ноги, что можно воспринять как адаптор; откидывает голову и облизывает губы</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2749"
